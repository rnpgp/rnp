# ci/prebuilt-versions.env
#
# Single source of truth for dependency versions used by
# ci/build_prebuilt.sh (Linux glibc, Linux musl, macOS). The bash
# script downloads and builds each dep from source with these
# exact versions.
#
# ci/build_prebuilt.ps1 (Windows MSVC) uses vcpkg instead, which
# has its own per-port versioning. The two versioning models are
# intentionally separate: vcpkg's ports are tested as a set, and
# overriding them would diverge from what every other vcpkg
# consumer sees. Bump versions here for the source-based path;
# bump vcpkg baseline (or add overrides) for the Windows path.
#
# Format: KEY=VALUE, one per line. Sourced by bash via `source`.
# No shell expansion -- values are literals.

ZLIB_VERSION=1.3.1
BZIP2_VERSION=1.0.8
JSONC_VERSION=0.19
BOTAN_VERSION=3.6.0
OPENSSL_VERSION=3.6.0
