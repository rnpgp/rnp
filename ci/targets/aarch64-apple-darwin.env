# ci/targets/aarch64-apple-darwin.env
# See docs/specs/target-matrix.adoc for the contract.

TARGET_OS=darwin
TARGET_ARCH=aarch64
TARGET_ARCHIVE_EXT=.a
TARGET_LIB_PREFIX=lib
TARGET_PLATFORM_LINK='-lc++ -framework Security -framework CoreFoundation'
TARGET_OPENSSL_CC=darwin64-arm64-cc
# Apple Silicon macOS shipped from 12.0 (Big Sur was Intel-only at
# launch); earlier targets aren't supported on this arch.
TARGET_DEPLOY_TARGET=12.0
TARGET_DESCRIPTION='macOS Apple Silicon'
