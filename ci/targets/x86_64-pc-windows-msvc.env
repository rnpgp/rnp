# ci/targets/x86_64-pc-windows-msvc.env
# See docs/specs/target-matrix.adoc for the contract.

TARGET_OS=windows
TARGET_ARCH=x86_64
TARGET_ARCHIVE_EXT=.lib
TARGET_LIB_PREFIX=
# MSVC links system libraries via the .lib files' embedded
# dependencies; no extra link flags needed by consumers.
TARGET_PLATFORM_LINK=
# Windows uses vcpkg instead of building OpenSSL from source. Empty
# here; the OpenSSL-specific ./Configure path is skipped on Windows.
TARGET_OPENSSL_CC=
TARGET_DEPLOY_TARGET=
TARGET_DESCRIPTION='Windows MSVC x86_64'
