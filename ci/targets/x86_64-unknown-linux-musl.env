# ci/targets/x86_64-unknown-linux-musl.env
# See docs/specs/target-matrix.adoc for the contract.

TARGET_OS=linux
TARGET_ARCH=x86_64
TARGET_ARCHIVE_EXT=.a
TARGET_LIB_PREFIX=lib
TARGET_PLATFORM_LINK='-lstdc++ -lm -lpthread -ldl'
TARGET_OPENSSL_CC=linux-x86_64
TARGET_DEPLOY_TARGET=
TARGET_DESCRIPTION='Linux musl x86_64 (Alpine)'
