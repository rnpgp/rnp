# ci/targets/x86_64-apple-darwin.env
# See docs/specs/target-matrix.adoc for the contract.

TARGET_OS=darwin
TARGET_ARCH=x86_64
TARGET_ARCHIVE_EXT=.a
TARGET_LIB_PREFIX=lib
# macOS needs the C++ runtime + Security framework for some librnp
# backends (notably when wrapping CommonCrypto paths).
TARGET_PLATFORM_LINK='-lc++ -framework Security -framework CoreFoundation'
TARGET_OPENSSL_CC=darwin64-x86_64-cc
# Broadest compatibility: build for the oldest macOS that still gets
# Apple security updates. Apple Silicon ships from 12.0; Intel from
# 11.0.
TARGET_DEPLOY_TARGET=11.0
TARGET_DESCRIPTION='macOS Intel'
