# ci/targets/x86_64-unknown-linux-gnu.env
#
# Per-target config. Read by ci/build_prebuilt.sh, ci/build_prebuilt.ps1,
# and ci/test_prebuilt.sh via source/parse. Adding a new target = adding
# a new file in this directory; no other code edits required.
#
# See docs/specs/target-matrix.adoc for the contract every target config
# must satisfy.

# OS family. Used for sanity-checking that the host platform matches
# the target's family (the script refuses to cross-build).
TARGET_OS=linux

# Architecture. Used for OpenSSL's --cc target selection and for
# sanity-checking against uname -m.
TARGET_ARCH=x86_64

# Static archive extension. .a on Unix, .lib on Windows MSVC.
TARGET_ARCHIVE_EXT=.a

# Library name prefix. "lib" on Unix, "" on Windows.
TARGET_LIB_PREFIX=lib

# Platform-specific link flags that downstream consumers must add
# when linking the static librnp tarball. Empty on Windows (the .lib
# files include the necessary system lib references via MSVC).
TARGET_PLATFORM_LINK='-lstdc++ -lm -lpthread -ldl'

# OpenSSL's ./Configure target for this platform. Used by
# ci/build_prebuilt.sh's build_openssl() function. Empty for non-
# Linux/Darwin targets (Windows uses vcpkg instead of building
# OpenSSL from source).
TARGET_OPENSSL_CC=linux-x86_64

# macOS-only: minimum deployment target (MACOSX_DEPLOYMENT_TARGET).
# Empty on non-macOS targets.
TARGET_DEPLOY_TARGET=

# Human-readable note about the target, shown in MANIFEST.txt.
TARGET_DESCRIPTION='Linux glibc x86_64'
