# ci/backends/botan.env
#
# Backend config for the Botan crypto backend (CRYPTO_BACKEND=botan).
# Read by ci/build_prebuilt.sh, ci/build_prebuilt.ps1, and
# ci/test_prebuilt.sh via source/parse. Adding a new backend = adding
# a new file in this directory; no other code edits required.
#
# See docs/specs/backends.adoc for the contract every backend config
# must satisfy.

# Human-readable description shown in MANIFEST.txt and CI logs.
BACKEND_DESCRIPTION='Botan 3.x (with PQC modules)'

# Extra dependencies to install (in addition to the common
# bzip2 + zlib + json-c). Used by build_prebuilt.ps1's vcpkg install
# step; build_prebuilt.sh dispatches to build_botan() based on the
# backend name.
BACKEND_DEPS=botan

# CMake flags passed to the rnp configure step for this backend.
# -DENABLE_PQC=ON enables rnp's PQC key types via Botan's PQ modules.
BACKEND_CMAKE_FLAGS=-DENABLE_PQC=ON

# Subdirectory under include/ that holds the backend's public
# headers. Used by test_prebuilt.sh's structural check.
BACKEND_HEADERS_DIR=botan-3

# Link flags (in link order) for a Unix-style linker. Used by
# ci/build_prebuilt.sh's MANIFEST.txt generator and by
# ci/test_prebuilt.sh's end-to-end link check (as a fallback when
# pkg-config isn't available).
BACKEND_LINK_LIBS='-lrnp -lsexpp -lbotan-3 -ljson-c -lz -lbz2'

# Link flags for MSVC (Windows). The .lib names follow vcpkg's
# x64-windows-static triplet conventions.
BACKEND_WINDOWS_LINK_LIBS='rnp.lib sexpp.lib botan-3.lib json-c.lib zlib.lib libbz2.lib'

# Required static archives in the tarball (comma-separated). Used by
# test_prebuilt.sh's structural check. The script accepts either the
# `lib<name>.<ext>` or `<name>.<ext>` spelling.
BACKEND_LIB_NAMES=librnp,libsexpp,libbotan-3,libjson-c,libz,libbz2

# Static archives on Windows use the .lib extension instead of .a.
# Same names as BACKEND_LIB_NAMES but with .lib.
BACKEND_WINDOWS_LIB_NAMES=rnp,sexpp,botan-3,json-c,zlib,libbz2
